node_modules/
dist/
out/
release/

# Speech + translation models are downloaded on first run, never committed.
# Without the directory rule below, `git add .` commits ~613MB of Vosk models.
assets/models/*/
assets/models/*.tar.gz
assets/models/*.bin
assets/models/*.zip

# Built from node_modules by scripts/build-vendor.js
src/vendor/

# Voice/ML models downloaded locally (XTTS ~1.8GB, etc.) - never committed
models/
experiments/**/out/
experiments/**/*.wav

# Local overrides
.env
.env.local
*.log
